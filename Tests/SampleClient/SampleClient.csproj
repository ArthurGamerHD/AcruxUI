<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Harness.Client</AssemblyName>
    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AdkRoot)/Adk.Analyzer/Adk.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
    </ProjectReference>
    <ProjectReference Include="$(AcruxRoot)/Acrux.Generator/Acrux.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
    </ProjectReference>
    <AdditionalFiles Include="**/*.xaml" />
    <None Include="Styles/**" CopyToOutputDirectory="PreserveNewest" LinkBase="Styles" />
  </ItemGroup>
  <Import Project="../../ClientApi/ClientApi.projitems" />
</Project>
