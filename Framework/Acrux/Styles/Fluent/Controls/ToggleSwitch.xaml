<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ToggleSwitch">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="PART_MovingKnobs"
                  Background="{TemplateBinding Background}"
                  CornerRadius="15"
                  BorderThickness="0" />
          <Border Name="PART_SwitchKnob"
                  Background="#FFFFFFFF"
                  CornerRadius="12"
                  BorderThickness="0" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Background" Value="{DynamicResource borderVariantColor}" />
  </Style>
  <Style Selector="ToggleSwitch:checked">
    <Setter Property="Background" Value="{DynamicResource accentColor}" />
  </Style>
</Styles>
