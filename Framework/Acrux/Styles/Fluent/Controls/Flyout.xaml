<?xml version="1.0" encoding="utf-8"?>
<!-- The Flyout's surface: the presenter Border around its content (Flyout.FlyoutPresenterClasses adds classes). -->
<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.flyout-presenter">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource borderVariantColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
  </Style>
</Styles>
