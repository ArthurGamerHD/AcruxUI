<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netframework48</TargetFramework>
    <RootNamespace>AcruxAppTemplate</RootNamespace>
    <LangVersion>6</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Release;Debug</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Stock MDK2 (NuGet): game references, the mod whitelist analyzer and the packer. -->
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.2.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Acrux UI: ClientApi source + the two generators, from packages/ (update with update-acrux.sh / .bat). -->
  <ItemGroup>
    <PackageReference Include="Acrux.Sdk" Version="ACRUX_SDK_VERSION" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Content\*\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <AdditionalFiles Include="thumb.png" Condition="Exists('thumb.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <AdditionalFiles Remove="Content\*\**\*.cs" />
    <None Remove="thumb.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Content\" />
    <Folder Include="Scripts\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Client\View\CounterView.cs">
      <DependentUpon>CounterView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Rider preview (Debug builds; install tools/acrux-preview.jar): the theme previewed views get. -->
  <PropertyGroup>
    <AcruxPreviewDesignResources>AcruxAppTemplate.Client.Resources.DesignTheme</AcruxPreviewDesignResources>
  </PropertyGroup>
</Project>
