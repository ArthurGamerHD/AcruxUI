<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12 5 12 5" />
  </Style>
  <!-- MenuItem derives from Button here; its states replace the button outline, fill and press shrink. -->
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource accentColor}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="MenuItem:pressed">
    <Setter Property="Background" Value="{DynamicResource accentColor}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector="MenuItem:focus-visible">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="MenuItem:open">
    <Setter Property="Background" Value="{DynamicResource accentContainerColor}" />
  </Style>
  <Style Selector="MenuItem TextBlock.menu-header">
    <Setter Property="FontFamily" Value="{DynamicResource textFont}" />
    <Setter Property="Foreground" Value="{DynamicResource fontColor}" />
    <Setter Property="FontSize" Value="0.58" />
  </Style>
  <Style Selector="MenuItem:pointerover TextBlock.menu-header">
    <Setter Property="Foreground" Value="{DynamicResource onAccentColor}" />
  </Style>
  <Style Selector="MenuItem:open TextBlock.menu-header">
    <Setter Property="Foreground" Value="{DynamicResource onAccentColor}" />
  </Style>
  <Style Selector="MenuItem:disabled TextBlock.menu-header">
    <Setter Property="Foreground" Value="{DynamicResource disabledColor}" />
  </Style>
  <Style Selector="MenuItem Border.menu-icon-host">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0 0 8 0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="MenuItem Border.menu-icon">
    <Setter Property="Background" Value="{DynamicResource fontColor}" />
  </Style>
  <Style Selector="MenuItem Border.menu-arrow">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="12 0 0 0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource fontColor}" />
  </Style>
  <Style Selector="Border.menu-dropdown">
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource borderVariantColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
  </Style>
</Styles>
